generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id            Int      @id @default(autoincrement()) 
  firstName     String
  surName       String
  email         String   @unique
 
  password      String
  createdAt     DateTime   @default(now()) 
  updatedAt     DateTime   @updatedAt

 
  getInbox     Inbox[]  @relation("GetInbox")
  userWallet   Wallet[]
} 

model LoggingTransaction {
  id            Int      @id @default(autoincrement())
  senderId      Int 
  recipientId   Int
  url           String
  method        String
  statusCode    Int
  sumToSend     Int
  convertedSum  Int
  createdAt     DateTime   @default(now()) 
  updatedAt     DateTime   @updatedAt

  sender    Wallet @relation("GetSender", fields: [senderId], references: [id])
  recipient Wallet @relation("GetRecipient",fields: [recipientId], references: [id])
}

model Inbox {
  id               Int         @id @default(autoincrement())
  userId           Int
  topic            String
  message          String
  type             Int
  mailId           String

  userInbox    User @relation("GetInbox", fields: [userId], references: [id]) 
}

model Wallet {
  id            Int     @id @default(autoincrement())
  userId        Int     
  cardNumber    String   @unique
  cardIndex     String   @unique
  currency      String
  balance       Int    @default(0)
  createdAt     DateTime   @default(now()) 
  updatedAt     DateTime   @updatedAt

  userWallet   User     @relation(fields: [userId], references: [id])
  getSender    LoggingTransaction[] @relation("GetSender")
  getRecipient LoggingTransaction[] @relation("GetRecipient")
}